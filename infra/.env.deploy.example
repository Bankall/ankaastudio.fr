# Copy to .env.deploy and fill in. .env.deploy is gitignored — never commit secrets.

# --- AWS ---
AWS_PROFILE=bankall
AWS_REGION=eu-west-1
STACK_NAME=ankaa-gallery

# --- Buckets (must be globally unique) ---
SITE_BUCKET=ankaa-site
MEDIA_BUCKET=ankaa-media
# Holds packaged Lambda zips. Created by bootstrap.sh.
ARTIFACTS_BUCKET=

# --- Domain ---
DOMAIN_NAME=ankaastudio.fr
# Leave EMPTY for the first deploy. The stack then comes up on its
# *.cloudfront.net domain so the whole system can be exercised before DNS moves.
# Fill in once the ACM certificate is ISSUED — it must live in us-east-1.
CERTIFICATE_ARN=

# --- CloudFront signing (emitted by bootstrap.sh) ---
KEY_GROUP_ID=
CF_KEY_PAIR_ID=

# --- Email ---
SENDER_EMAIL=contact@ankaastudio.fr

# --- SSM ---
SSM_PREFIX=/ankaa/gallery

# --- Lambda concurrency ---
# Cap on parallel sharp workers, or 0 for no reservation. Lambda rejects any
# reservation that leaves the account under 10 unreserved executions, and a new
# AWS account's total quota is 10, so leave this at 0 until that quota is raised:
#   aws service-quotas request-service-quota-increase --service-code lambda \
#     --quota-code L-B99A9384 --desired-value 1000 --profile bankall
PROCESSOR_RESERVED_CONCURRENCY=0
